  "schemas": {
    "trigger:schedule": {
      "title": "定时触发器",
      "note": "常用间隔可直接选择；复杂调度再切换到 Cron 表达式（秒 分 时 日 月 周）。",
      "fields": [
        {
          "key": "mode",
          "label": "调度方式",
          "type": "select",
          "options": [
            "minutes",
            "seconds",
            "cron"
          ],
          "default": "minutes",
          "required": true,
          "labels": {
            "minutes": "每隔 N 分钟",
            "seconds": "每隔 N 秒",
            "cron": "Cron 表达式（高级）"
          },
          "hint": "简单周期用间隔，复杂规则用 Cron"
        },
        {
          "key": "everyMinutes",
          "label": "间隔（分钟）",
          "type": "number",
          "placeholder": "5",
          "default": "5",
          "required": true,
          "showWhen": {
            "key": "mode",
            "in": [
              "minutes"
            ]
          },
          "hint": "每 5 分钟即从整点起 00:00、00:05、00:10… 执行"
        },
        {
          "key": "everySeconds",
          "label": "间隔（秒）",
          "type": "number",
          "placeholder": "30",
          "default": "30",
          "required": true,
          "showWhen": {
            "key": "mode",
            "in": [
              "seconds"
            ]
          },
          "hint": "秒级调度请确保单次执行时长小于间隔"
        },
        {
          "key": "cron",
          "label": "Cron 表达式",
          "type": "text",
          "placeholder": "0/5 * * * * ?",
          "required": true,
          "showWhen": {
            "key": "mode",
            "in": [
              "cron"
            ]
          },
          "hint": "Spring Cron：秒 分 时 日 月 周，例如 0 0 8 * * ? 表示每天 08:00"
        },
        {
          "key": "timezone",
          "label": "时区",
          "type": "text",
          "placeholder": "Asia/Shanghai",
          "default": "Asia/Shanghai"
        },
        {
          "key": "enabled",
          "label": "启用调度",
          "type": "select",
          "options": [
            "是",
            "否"
          ],
          "default": "是"
        },
        {
          "key": "catchUp",
          "label": "错过执行补偿",
          "type": "select",
          "options": [
            "跳过",
            "立即补跑"
          ],
          "default": "跳过",
          "hint": "服务重启后对遗漏执行点的处理策略"
        },
        {
          "key": "desc",
          "label": "说明",
          "type": "text",
          "placeholder": "每 5 分钟采集一次"
        }
      ]
    },
    "trigger:manual": {
      "title": "手动触发器",
      "note": "由用户在画布点击“运行”或调用 API 触发。",
      "fields": [
        {
          "key": "allowParams",
          "label": "允许运行参数",
          "type": "select",
          "options": [
            "是",
            "否"
          ],
          "default": "否"
        },
        {
          "key": "params",
          "label": "参数模板 (JSON)",
          "type": "textarea",
          "rows": 3,
          "placeholder": "{\"startDate\": \"2026-11-21\"}",
          "showWhen": {
            "key": "allowParams",
            "in": [
              "是"
            ]
          }
        },
        {
          "key": "desc",
          "label": "说明",
          "type": "text",
          "placeholder": "按需手动执行"
        }
      ]
    },
    "source:opcua": {
      "title": "OPC UA 读取节点",
      "note": "采集前请确认服务端证书信任与节点访问权限。",
      "fields": [
        {
          "key": "datasource",
          "label": "数据源",
          "type": "datasource",
          "required": true,
          "hint": "从数据源管理中选择已配置的 OPC UA 连接"
        },
        {
          "key": "nodeId",
          "label": "节点 ID",
          "type": "text",
          "placeholder": "ns=3;s=Temperature.PT101",
          "required": true
        },
        {
          "key": "readMode",
          "label": "读取方式",
          "type": "select",
          "options": [
            "订阅 (Subscription)",
            "轮询 (Poll)"
          ],
          "default": "订阅 (Subscription)"
        },
        {
          "key": "interval",
          "label": "采集间隔",
          "type": "text",
          "placeholder": "1000ms",
          "default": "1000ms"
        },
        {
          "key": "qualityFilter",
          "label": "质量戳过滤",
          "type": "select",
          "options": [
            "仅 GOOD",
            "不过滤"
          ],
          "default": "仅 GOOD"
        },
        {
          "key": "timeout",
          "label": "超时时间",
          "type": "text",
          "placeholder": "5000ms",
          "default": "5000ms"
        }
      ]
    },
    "source:modbus": {
      "title": "Modbus 读取节点",
      "note": "寄存器地址从 40001 起算时，请在工具中确认与协议地址的偏移关系。",
      "fields": [
        {
          "key": "datasource",
          "label": "数据源",
          "type": "datasource",
          "required": true,
          "hint": "从数据源管理中选择已配置的 Modbus TCP 连接"
        },
        {
          "key": "port",
          "label": "端口",
          "type": "number",
          "placeholder": "502",
          "default": "502"
        },
        {
          "key": "slaveId",
          "label": "从站号",
          "type": "number",
          "placeholder": "1",
          "default": "1"
        },
        {
          "key": "registerType",
          "label": "寄存器类型",
          "type": "select",
          "options": [
            "保持寄存器",
            "输入寄存器",
            "线圈",
            "离散输入"
          ],
          "default": "保持寄存器"
        },
        {
          "key": "startAddress",
          "label": "起始地址",
          "type": "text",
          "placeholder": "40001",
          "required": true
        },
        {
          "key": "count",
          "label": "读取数量",
          "type": "number",
          "placeholder": "10",
          "default": "10"
        },
        {
          "key": "byteOrder",
          "label": "字节序",
          "type": "select",
          "options": [
            "ABCD",
            "CDAB",
            "BADC",
            "DCBA"
          ],
          "default": "ABCD"
        },
        {
          "key": "pollInterval",
          "label": "轮询间隔",
          "type": "text",
          "placeholder": "500ms",
          "default": "500ms"
        }
      ]
    },
    "source:mqtt": {
      "title": "MQTT 订阅节点",
      "note": "支持通配符主题；生产环境建议启用认证并使用 TLS。",
      "fields": [
        {
          "key": "datasource",
          "label": "数据源",
          "type": "datasource",
          "required": true,
          "hint": "从数据源管理中选择已配置的 MQTT Broker"
        },
        {
          "key": "topic",
          "label": "订阅主题",
          "type": "text",
          "placeholder": "plant/+/temp",
          "required": true
        },
        {
          "key": "qos",
          "label": "QoS",
          "type": "select",
          "options": [
            "0",
            "1",
            "2"
          ],
          "default": "1"
        },
        {
          "key": "clientId",
          "label": "Client ID",
          "type": "text",
          "placeholder": "留空自动生成"
        },
        {
          "key": "payloadFormat",
          "label": "消息格式",
          "type": "select",
          "options": [
            "JSON",
            "原始字符串"
          ],
          "default": "JSON"
        },
        {
          "key": "cleanSession",
          "label": "Clean Session",
          "type": "select",
          "options": [
            "是",
            "否"
          ],
          "default": "是"
        },
        {
          "key": "username",
          "label": "用户名凭据",
          "type": "credential",
          "hint": "从变量配置 → 凭据中选择"
        },
        {
          "key": "password",
          "label": "密码凭据",
          "type": "credential",
          "hint": "从变量配置 → 凭据中选择"
        }
      ]
    },
    "source:http": {
      "title": "HTTP 请求节点",
      "note": "请求头与查询参数使用 JSON 格式，敏感值请引用凭据。",
      "fields": [
        {
          "key": "method",
          "label": "请求方法",
          "type": "select",
          "options": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "default": "GET"
        },
        {
          "key": "url",
          "label": "请求地址",
          "type": "text",
          "placeholder": "https://mes.factory.local/api/v1/orders",
          "required": true
        },
        {
          "key": "query",
          "label": "查询参数 (JSON)",
          "type": "textarea",
          "rows": 3,
          "placeholder": "{\"date\": \"today\"}"
        },
        {
          "key": "headers",
          "label": "请求头 (JSON)",
          "type": "textarea",
          "rows": 3,
          "placeholder": "{\"Content-Type\": \"application/json\"}"
        },
        {
          "key": "auth",
          "label": "认证凭据",
          "type": "credential",
          "hint": "从变量配置 → 凭据中选择，例如 MES_API_TOKEN"
        },
        {
          "key": "expectedStatus",
          "label": "期望状态码",
          "type": "text",
          "placeholder": "200",
          "default": "200"
        },
        {
          "key": "timeout",
          "label": "超时时间",
          "type": "text",
          "placeholder": "10000ms",
          "default": "10000ms"
        }
      ]
    },
    "source:kafka": {
      "title": "Kafka 消费节点",
      "note": "消费位点与分组提交策略会影响数据重复性。",
      "fields": [
        {
          "key": "datasource",
          "label": "数据源",
          "type": "datasource",
          "required": true,
          "hint": "从数据源管理中选择已配置的 Kafka 连接"
        },
        {
          "key": "topic",
          "label": "Topic",
          "type": "text",
          "placeholder": "factory.events",
          "required": true
        },
        {
          "key": "groupId",
          "label": "Consumer Group",
          "type": "text",
          "placeholder": "dfs-collector",
          "required": true
        },
        {
          "key": "offsetReset",
          "label": "位点策略",
          "type": "select",
          "options": [
            "earliest",
            "latest"
          ],
          "default": "latest"
        },
        {
          "key": "deserializer",
          "label": "反序列化",
          "type": "select",
          "options": [
            "JSON",
            "String"
          ],
          "default": "JSON"
        },
        {
          "key": "batchSize",
          "label": "批量大小",
          "type": "number",
          "placeholder": "100",
          "default": "100"
        },
        {
          "key": "autoCommit",
          "label": "自动提交位点",
          "type": "select",
          "options": [
            "是",
            "否"
          ],
          "default": "否"
        }
      ]
    },
    "source:mysql": {
      "title": "MySQL 数据库节点",
      "note": "支持增删改查；字段按需显示。连接建议引用凭据，不要在流程中明文写密码。",
      "fields": [
        {
          "key": "connection",
          "label": "连接数据源",
          "type": "datasource",
          "required": true,
          "hint": "从已创建的数据源中选择，无需手填连接串"
        },
        {
          "key": "operation",
          "label": "操作类型",
          "type": "select",
          "options": [
            "select",
            "insert",
            "update",
            "delete",
            "execute"
          ],
          "default": "select",
          "required": true,
          "hint": "SELECT / INSERT / UPDATE / DELETE / 执行原始 SQL"
        },
        {
          "key": "table",
          "label": "数据表",
          "type": "text",
          "placeholder": "schema.table",
          "required": true,
          "showWhen": {
            "key": "operation",
            "in": [
              "select",
              "insert",
              "update",
              "delete"
            ]
          }
        },
        {
          "key": "columns",
          "label": "字段列表",
          "type": "text",
          "placeholder": "id, order_no, updated_at",
          "hint": "SELECT / INSERT 使用",
          "showWhen": {
            "key": "operation",
            "in": [
              "select",
              "insert"
            ]
          }
        },
        {
          "key": "where",
          "label": "WHERE 条件",
          "type": "text",
          "placeholder": "synced = 0 AND updated_at > {{ $now.minus(5, \"minutes\") }}",
          "hint": "参数可用 {{ $vars.xxx }} 引用",
          "showWhen": {
            "key": "operation",
            "in": [
              "select",
              "update",
              "delete"
            ]
          }
        },
        {
          "key": "values",
          "label": "写入值 (JSON)",
          "type": "textarea",
          "rows": 4,
          "placeholder": "{\"order_no\": \"SO-2026-001\"}",
          "hint": "INSERT 的字段值 / UPDATE 的 SET 值",
          "showWhen": {
            "key": "operation",
            "in": [
              "insert",
              "update"
            ]
          }
        },
        {
          "key": "sql",
          "label": "自定义 SQL",
          "type": "textarea",
          "rows": 5,
          "placeholder": "SELECT ... FROM ... WHERE ...",
          "hint": "仅“执行原始 SQL”时启用",
          "showWhen": {
            "key": "operation",
            "in": [
              "execute"
            ]
          }
        },
        {
          "key": "limit",
          "label": "最大返回行数",
          "type": "number",
          "placeholder": "500",
          "default": "500",
          "showWhen": {
            "key": "operation",
            "in": [
              "select"
            ]
          }
        },
        {
          "key": "conflict",
          "label": "冲突处理",
          "type": "text",
          "placeholder": "ON CONFLICT (id) DO NOTHING",
          "hint": "可选，留空则使用默认策略",
          "showWhen": {
            "key": "operation",
            "in": [
              "insert"
            ]
          }
        },
        {
          "key": "timeout",
          "label": "超时时间",
          "type": "text",
          "placeholder": "30000ms",
          "default": "30000ms"
        }
      ]
    },

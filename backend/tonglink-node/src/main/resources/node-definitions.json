        {
          "key": "collection",
          "label": "集合",
          "type": "text",
          "placeholder": "plant.events",
          "required": true
        },
        {
          "key": "filter",
          "label": "查询条件 (JSON)",
          "type": "textarea",
          "rows": 3,
          "placeholder": "{\"status\": \"new\"}"
        },
        {
          "key": "documents",
          "label": "写入文档 (JSON)",
          "type": "textarea",
          "rows": 4,
          "placeholder": "[{\"name\": \"PT101\"}]",

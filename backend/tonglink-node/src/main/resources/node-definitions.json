    "logic:condition": {
      "title": "条件分支",
      "note": "逐条数据求值：命中走 true 端口，其余走 false 端口。复杂多路分支可串联多个条件节点。",
      "fields": [
        {
          "key": "expression",
          "label": "条件表达式",
          "type": "text",
          "placeholder": "{{ $json.temp > $vars.TEMP_THRESHOLD }}",
          "required": true
        },
        {
          "key": "mode",
          "label": "分支模式",
          "type": "select",
          "options": [
            "二分支 (true/false)"
          ],
          "default": "二分支 (true/false)",
          "hint": "多路分支请串联多个条件节点，每个节点负责一个判断条件。"
        },
        {
          "key": "unmatched",
          "label": "未匹配处理",
          "type": "select",
          "options": [
            "丢弃",
            "走默认分支"
          ],
          "default": "走默认分支",
          "hint": "选「丢弃」时，不满足条件的数据不会进入 false 端口。"
        },
        {
          "key": "desc",
          "label": "说明",
          "type": "text",
          "placeholder": "温度超阈值时进入告警分支"
        }
      ]
    },
    "logic:filter": {
      "title": "数据过滤",
      "note": "仅保留满足表达式的数据项。",
      "fields": [
        {
          "key": "expression",
          "label": "过滤表达式",
          "type": "text",
          "placeholder": "{{ $json.quality === \"GOOD\" }}",
          "required": true
        },
        {
          "key": "maxItems",
          "label": "最大保留条数",
          "type": "number",
          "placeholder": "1000",
          "default": "1000"
        },
        {
          "key": "desc",
          "label": "说明",
          "type": "text",
          "placeholder": "过滤无效质量戳"
        }
      ]
    },
    "logic:merge": {
      "title": "数据合并",
      "note": "将多路输入合并为单一输出。",

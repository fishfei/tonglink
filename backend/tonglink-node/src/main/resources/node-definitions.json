    "logic:condition": {
      "title": "条件分支节点",
      "note": "根据表达式结果将数据分流到 true / false 端口。",
      "fields": [
        {
          "key": "expression",
          "label": "条件表达式",
          "type": "text",
          "placeholder": "{{ $json.temp > $vars.TEMP_THRESHOLD }}",
          "required": true
        },
        {
          "key": "mode",
          "label": "分支模式",
          "type": "select",
          "options": [
            "二分支 (true/false)",
            "多分支 (Switch)"
          ],
          "default": "二分支 (true/false)"
        },
        {
          "key": "unmatched",
          "label": "未匹配处理",
          "type": "select",
          "options": [
            "丢弃",
            "走默认分支"
          ],
          "default": "丢弃"
        },
        {
          "key": "desc",
          "label": "说明",
          "type": "text",
          "placeholder": "温度超阈值时进入告警分支"
        }
      ]
    },
    "logic:filter": {
      "title": "数据过滤节点",
      "note": "仅保留满足表达式的数据项。",
      "fields": [
        {
          "key": "expression",
          "label": "过滤表达式",
          "type": "text",
          "placeholder": "{{ $json.quality === \"GOOD\" }}",
          "required": true
        },
        {
          "key": "maxItems",
          "label": "最大保留条数",
          "type": "number",
          "placeholder": "1000",
          "default": "1000"
        },
        {
          "key": "desc",
          "label": "说明",
          "type": "text",
          "placeholder": "过滤无效质量戳"
        }
      ]
    },
    "logic:merge": {
      "title": "数据合并节点",
      "note": "将多路输入合并为单一输出。",
      "fields": [
        {
          "key": "strategy",
          "label": "合并策略",
          "type": "select",
          "options": [
            "追加",
            "按字段合并",
            "覆盖"
          ],
          "default": "追加"
        },
        {
          "key": "matchField",
          "label": "匹配字段",
          "type": "text",
          "placeholder": "device_id",
          "showWhen": {
            "key": "strategy",
            "in": [
              "按字段合并"
            ]
          }
        },
        {
          "key": "dedupe",
          "label": "去重",
          "type": "select",
          "options": [
            "是",
            "否"
          ],
          "default": "否"
        },
        {
          "key": "maxItems",
          "label": "最大条数",
          "type": "number",
          "placeholder": "5000",
          "default": "5000"
        }
      ]
    },
    "logic:delay": {
      "title": "延时等待节点",
      "note": "用于错峰写入或等待上游设备就绪。",
      "fields": [
        {
          "key": "duration",
          "label": "延时时长",
          "type": "number",
          "placeholder": "5",
          "required": true
        },
        {
          "key": "unit",
          "label": "单位",
          "type": "select",
          "options": [
            "毫秒",
            "秒",
            "分钟"
          ],
          "default": "秒"
        },
        {
          "key": "blockDownstream",
          "label": "阻塞下游",
          "type": "select",
          "options": [
            "是",
            "否"
          ],
          "default": "是"
        },
        {
          "key": "desc",
          "label": "说明",
          "type": "text",
          "placeholder": "等待 PLC 数据就绪"
        }
      ]
    },
    "output:timeseries": {

    "source:postgres": {
      "title": "PostgreSQL 数据库节点",
      "note": "支持增删改查；字段按需显示。连接建议引用凭据，不要在流程中明文写密码。",
      "fields": [
        {
          "key": "connection",
          "label": "连接数据源",
          "type": "datasource",
          "required": true,
          "hint": "从已创建的数据源中选择，无需手填连接串"
        },
        {
          "key": "operation",
          "label": "操作类型",
          "type": "select",
          "options": [
            "select",
            "insert",
            "update",
            "delete",
            "execute"
          ],
          "default": "select",
          "required": true,
          "hint": "SELECT / INSERT / UPDATE / DELETE / 执行原始 SQL"
        },
        {
          "key": "table",
          "label": "数据表",
          "type": "text",
          "placeholder": "schema.table",
          "required": true,
          "showWhen": {
            "key": "operation",
            "in": [
              "select",
              "insert",
              "update",
              "delete"
            ]
          }
        },
        {
          "key": "columns",
          "label": "字段列表",
          "type": "text",
          "placeholder": "id, order_no, updated_at",
          "hint": "SELECT / INSERT 使用",
          "showWhen": {
            "key": "operation",
            "in": [
              "select",
              "insert"
            ]
          }
        },
        {
          "key": "where",
          "label": "WHERE 条件",
          "type": "text",
          "placeholder": "synced = 0 AND updated_at > {{ $now.minus(5, \"minutes\") }}",
          "hint": "参数可用 {{ $vars.xxx }} 引用",
          "showWhen": {
            "key": "operation",
            "in": [
              "select",
              "update",
              "delete"
            ]
          }
        },
        {
          "key": "values",
          "label": "写入值 (JSON)",
          "type": "textarea",
          "rows": 4,
          "placeholder": "{\"order_no\": \"SO-2026-001\"}",
          "hint": "INSERT 的字段值 / UPDATE 的 SET 值",
          "showWhen": {
            "key": "operation",
            "in": [
              "insert",
              "update"
            ]
          }
        },
        {
          "key": "sql",
          "label": "自定义 SQL",
          "type": "textarea",
          "rows": 5,
          "placeholder": "SELECT ... FROM ... WHERE ...",
          "hint": "仅“执行原始 SQL”时启用",
          "showWhen": {
            "key": "operation",
            "in": [
              "execute"
            ]
          }
        },
        {
          "key": "limit",
          "label": "最大返回行数",
          "type": "number",
          "placeholder": "500",
          "default": "500",
          "showWhen": {
            "key": "operation",
            "in": [
              "select"
            ]
          }
        },
        {
          "key": "conflict",
          "label": "冲突处理",
          "type": "text",
          "placeholder": "ON CONFLICT (id) DO NOTHING",
          "hint": "可选，留空则使用默认策略",
          "showWhen": {
            "key": "operation",
            "in": [
              "insert"
            ]
          }
        },
        {
          "key": "timeout",
          "label": "超时时间",
          "type": "text",
          "placeholder": "30000ms",
          "default": "30000ms"
        }
      ]
    },

        {
          "key": "pipeline",
          "label": "聚合管道 (JSON)",
          "type": "textarea",
          "rows": 4,
          "placeholder": "[{\"$match\": {}}]",
          "showWhen": {
            "key": "operation",
            "in": [
              "aggregate"
            ]
          }
        },
        {
          "key": "limit",
          "label": "最大返回条数",
          "type": "number",
          "placeholder": "100",
          "default": "100"
        },
        {
          "key": "timeout",
          "label": "超时时间",
          "type": "text",
          "placeholder": "30000ms",
          "default": "30000ms"
        }
      ]

        {
          "key": "maxItems",
          "label": "最大条数",
          "type": "number",
          "placeholder": "5000",
          "default": "5000"
        }
      ]
    },
    "logic:delay": {
      "title": "延时等待",
      "note": "异步等待：有输入也有输出；到期后把输入原样放行给下游，不占用工作线程；单次最长 24 小时。",

    "code:nodejs": {
      "title": "Node.js 代码节点",
      "note": "生产环境在独立进程/容器中执行，配置模块白名单与资源上限。可用 $input / $json / $vars / $env。",
      "fields": [
        {
          "key": "code",
          "label": "脚本",
          "type": "code",
          "required": true
        },
        {
          "key": "timeout",
          "label": "任务超时",
          "type": "text",
          "placeholder": "300s",
          "default": "300s"
        },
        {
          "key": "memoryLimit",
          "label": "内存上限",
          "type": "select",
          "options": [
            "128MB",
            "256MB",
            "512MB"
          ],
          "default": "256MB"
        },
        {
          "key": "allowedModules",
          "label": "允许模块（白名单）",
          "type": "text",
          "placeholder": "lodash, dayjs",
          "hint": "逗号分隔；内置模块也需显式授权"
        },
        {
          "key": "inputMode",
          "label": "输入模式",
          "type": "select",
          "options": [
            "逐条执行",
            "整批执行"
          ],
          "default": "整批执行"
        },
        {
          "key": "retry",
          "label": "失败重试次数",
          "type": "select",
          "options": [
            "0",
            "1",
            "2",
            "3"
          ],
          "default": "0"
        }
      ]
    },

    "source:mongodb": {
      "title": "MongoDB 节点",
      "note": "查询条件与更新内容使用 JSON 格式。",
      "fields": [
        {
          "key": "connection",
          "label": "连接数据源",
          "type": "datasource",
          "required": true,
          "hint": "从数据源管理中选择已配置的 MongoDB 连接"
        },
        {
          "key": "operation",
          "label": "操作类型",
          "type": "select",
          "options": [
            "find",
            "insertOne",
            "insertMany",
            "updateMany",
            "deleteMany",
            "aggregate"
          ],
          "default": "find"
